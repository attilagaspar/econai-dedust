# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Project data — entire projects/ folder is local only
projects/

# Authorities — shared reference data, TRACKED in the repo so every clone gets
# the same canonical IDs. Builders live with their source data, not here.
# (If an authority grows very large / churns often, move it to Git LFS.)
authorities/*
!authorities/*.md
!authorities/*.authority.json

# Sample data images (keep JSONs if you want, but images are large)
samples/**/*.jpg
samples/**/*.jpeg
samples/**/*.png
samples/**/*.tif
samples/**/*.tiff

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets / local config overrides
*.env
*.key
*.pem

# Claude Code session data
.claude/

# Temp/lock files
~$*
*.tmp

# Server logs & local runtime state
server*.log
server.err
server.out
app/ocr_settings.json
.llm_cache.sqlite

# Model weights (never in git)
*.pth

# Stray page images / screenshots dropped at the repo root
/*.png
/*.jpg
/*.jpeg

# Personal research notes
paper_ideas_separate.md

# Benchmark outputs (reports & raw model replies stay local)
benchmarks/vision_benchmark_*.md
benchmarks/raw_*.json
